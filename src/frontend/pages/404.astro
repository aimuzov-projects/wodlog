---
import NotFound from '@aimuzov/infra-site-kit/not-found.astro'

import Base from '#frontend/layouts/base.astro'
---

<Base title="Страница не найдена" description="Такой страницы на сайте нет." index={false}>
	<main class="missing">
		<!-- Без подсказок: в sitemap одна главная, а на неё и так ведёт кнопка. -->
		<NotFound suggest={false} />
	</main>
</Base>

<style>
	.missing {
		--not-found-accent: var(--accent);
		--not-found-muted: var(--muted);
		--not-found-radius: var(--radius);

		display: grid;
		align-items: center;
		min-height: 100svh;
	}
</style>
