---
import App from '#frontend/components/app.svelte'
import Base from '#frontend/layouts/base.astro'
---

<Base app>
	<!-- Скрипт Telegram должен успеть до приложения: он ставит тему и safe area в CSS-переменные. -->
	<script is:inline slot="head" src="https://telegram.org/js/telegram-web-app.js?59"></script>
	<App client:only="svelte" botUsername={import.meta.env.PUBLIC_BOT_USERNAME ?? ''} />
	<noscript>WODlog работает только с включённым JavaScript.</noscript>
</Base>
