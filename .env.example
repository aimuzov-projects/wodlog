# Переменные фронта (сборка) и API (рантайм) в одном файле. На сервере это /srv/wodlog/.env:
# фронт получает его секретом сборки, API -- через env_file.

# Имя бота без @: Login Widget и ссылки-приглашения.
PUBLIC_BOT_USERNAME=wodlogrobot

# Токен от @BotFather. Им подписывается вход из Mini App и Login Widget, им же API забирает апдейты бота.
BOT_TOKEN=
# Адрес Mini App, на него ведут кнопка в чате с ботом и кнопка меню.
APP_URL=https://wodlog.aimuzov.online

# Распознавание доски. Без ключа тренировку вводят вручную.
OPENROUTER_API_KEY=
# Пусто -- модель по умолчанию из src/backend/recognize.ts.
OPENROUTER_MODEL=

# Часовой пояс залов для «сегодня» в рейтинге.
APP_TIMEZONE=Europe/Moscow

# Только локально: кнопка «Войти без Telegram» и ручка /api/auth/dev.
# DATA_DIR=./data
# DEV_LOGIN=1
# Не забирать апдейты бота: иначе локальный API отбирает их у прода.
# BOT_POLLING=0
